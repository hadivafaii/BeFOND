{
  "description": "Small CPU demonstration; benchmark defaults live in configs/.",
  "model": {
    "input_dim": 12,
    "num_latents": 24,
    "seed": 0,
    "init_scale": 0.15,
    "prior_init_lower": -2.5,
    "prior_init_upper": -2.5,
    "fit_prior": true,
    "fit_dec_bias": false,
    "fit_dec_var": false,
    "dec_var_pixelwise": false,
    "inference_integrator": "etd1",
